embed-server --server-config=standalone-full.xml --std-out=echo
# Each operation is independently idempotent, including after partial startup.
if (outcome != success) of /deployment=postgresql.jar:read-resource
    deploy /verification/postgresql.jar
end-if
if (outcome != success) of /subsystem=datasources/data-source=SymphonyDS:read-resource
    /subsystem=datasources/data-source=SymphonyDS:add(jndi-name="java:/SymphonyDS",driver-name="postgresql.jar",connection-url="jdbc:postgresql://database:5432/symphony?currentSchema=symphony,public",user-name="acceptance",password="disposable-acceptance-only",enabled=true)
end-if
stop-embedded-server
